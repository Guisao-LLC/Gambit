{
  "name": "@guisao-llc/gambit-ui",
  "version": "0.4.0",
  "description": "Drop-in React panels for the screens every app has: profile details, avatar, and password change.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guisao-LLC/Gambit.git",
    "directory": "packages/gambit-ui"
  },
  "homepage": "https://github.com/Guisao-LLC/Gambit/tree/main/packages/gambit-ui",
  "keywords": [
    "react",
    "mui",
    "profile",
    "avatar",
    "password",
    "components"
  ],
  "engines": {
    "node": ">=20 <23"
  },
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && npm run build:esm",
    "clean": "tsc -b --clean && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test && node ../../scripts/prepublish-check.mjs",
    "build:esm": "tsc -p tsconfig.esm.json && node ../../scripts/mark-esm.mjs"
  },
  "dependencies": {
    "@guisao-llc/gambit-account": "^0.4.0",
    "@guisao-llc/gambit-person": "^0.2.0",
    "zod": "^4.0.17"
  },
  "peerDependencies": {
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@mui/icons-material": "^7",
    "@mui/material": "^7",
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
