# Copy to .env.development.local and fill in.

# Where Mongo lives. A local instance or an Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/__APP_NAME__

# Signs and verifies every token. Use a long random string, and a DIFFERENT
# one in production — anyone holding this can mint a token for any account.
JWT_SECRET=change-me-to-something-long-and-random

PORT=3001

# The browser origin allowed to call this API in development.
ORIGIN_URL=http://localhost:5173
