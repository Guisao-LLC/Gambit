{
  "name": "@guisao-llc/gambit-rbac",
  "version": "0.3.0",
  "description": "Roles, permissions, a permission cache, and the express middleware that enforces them.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guisao-LLC/Gambit.git",
    "directory": "packages/gambit-rbac"
  },
  "homepage": "https://github.com/Guisao-LLC/Gambit/tree/main/packages/gambit-rbac",
  "keywords": [
    "rbac",
    "permissions",
    "authorization",
    "express",
    "middleware"
  ],
  "engines": {
    "node": ">=20 <23"
  },
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && npm run build:esm",
    "clean": "tsc -b --clean && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test && node ../../scripts/prepublish-check.mjs",
    "build:esm": "tsc -p tsconfig.esm.json && node ../../scripts/mark-esm.mjs"
  },
  "dependencies": {
    "@guisao-llc/gambit-auth": "^0.2.0",
    "@guisao-llc/gambit-cascade": "^0.2.0"
  },
  "peerDependencies": {
    "express": "^4.21.0",
    "mongoose": ">=8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21"
  },
  "publishConfig": {
    "access": "public"
  }
}
