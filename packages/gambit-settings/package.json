{
  "name": "@guisao-llc/gambit-settings",
  "version": "0.2.0",
  "description": "A settings document there is exactly one of: fixed-key lookup, upsert-on-read, and an audit trail.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guisao-LLC/Gambit.git",
    "directory": "packages/gambit-settings"
  },
  "homepage": "https://github.com/Guisao-LLC/Gambit/tree/main/packages/gambit-settings",
  "keywords": [
    "settings",
    "singleton",
    "mongoose",
    "configuration"
  ],
  "engines": {
    "node": ">=20 <23"
  },
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && npm run build:esm",
    "clean": "tsc -b --clean && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test && node ../../scripts/prepublish-check.mjs",
    "build:esm": "tsc -p tsconfig.esm.json && node ../../scripts/mark-esm.mjs"
  },
  "peerDependencies": {
    "mongoose": ">=8"
  },
  "publishConfig": {
    "access": "public"
  }
}
