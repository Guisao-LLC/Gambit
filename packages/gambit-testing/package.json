{
  "name": "@guisao-llc/gambit-testing",
  "version": "0.4.0",
  "description": "The half of an authorization test suite that is the same in every app: assertions, a route manifest, and a per-permission grid generator.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guisao-LLC/Gambit.git",
    "directory": "packages/gambit-testing"
  },
  "homepage": "https://github.com/Guisao-LLC/Gambit/tree/main/packages/gambit-testing",
  "keywords": [
    "testing",
    "rbac",
    "authorization",
    "supertest",
    "jest",
    "vitest"
  ],
  "engines": {
    "node": ">=20 <23"
  },
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && npm run build:esm",
    "clean": "tsc -b --clean && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test && node ../../scripts/prepublish-check.mjs",
    "build:esm": "tsc -p tsconfig.esm.json && node ../../scripts/mark-esm.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
