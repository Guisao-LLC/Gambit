; Packages in the @guisao-llc scope live in GitHub Packages, not on npmjs.
; Everything else resolves normally from the public registry.
@guisao-llc:registry=https://npm.pkg.github.com

; The token is read from the environment so it is never committed. Set
; NODE_AUTH_TOKEN before publishing or installing:
;
;   local     export NODE_AUTH_TOKEN=<a PAT with write:packages>
;   CI        NODE_AUTH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
;   Render    add NODE_AUTH_TOKEN as an environment variable on the service
;
; Consuming apps need this same scope line plus a read:packages token, or
; `npm ci` fails at deploy time. See README.
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
